# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋하지 않습니다.
#
# ⚠️ 채팅/캡처 등으로 노출된 적 있는 토큰은 검증이 끝나면 사이트 설정(설정 → API)에서
# 재발급받아 교체하세요 (§11).
SNIPPET_SITE_TOKEN=
SNIPPET_SITE_BASE_URL=https://api.1000.school

# (폴백, 평소엔 비워둠) Bearer 토큰이 401/403으로 거부될 때만:
# 브라우저 F12 → Application → Cookies → app.1000.school 의 `session` 쿠키 값을 붙여넣기.
# 세션 만료 시 다시 로그인해 갱신해야 합니다.
SNIPPET_SITE_SESSION=

# 주의: ANTHROPIC_API_KEY는 여기(.env)는 물론 시스템 환경변수에도 있으면 안 됩니다.
# 존재하면 Claude Code가 구독 대신 API 과금으로 전환됩니다. daily.py/weekly.py가
# 시작 시 감지하면 경고 후 프로세스 환경에서 제거하고 진행합니다 (§4).
