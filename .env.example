# 복사해서 .env 로 저장하고 값을 채우세요. .env는 절대 커밋하지 마세요.

# ★ 비용 0원 원칙(DEV_SPEC §7.0): 키가 비어 있어도 DEMO_MODE=cached로 전 기능 데모 가능.
# 유료 키는 사용자가 명시적으로 결정한 경우에만 채운다.

# Anthropic Claude API (선택 — live 모드 전환 시에만) — console.anthropic.com
ANTHROPIC_API_KEY=

# 공공데이터포털 인증키 (오픈API 라이브 시연용, 무료 발급) — data.go.kr 마이페이지
DATA_GO_KR_API_KEY=

# 런타임 설정
DEMO_MODE=cached          # cached(기본, 0원) | live
DATABASE_PATH=data/krosetta.db
