# 복사해서 .env 로 저장하고 값을 채우세요. .env는 절대 커밋하지 마세요.

# Anthropic Claude API (필수) — console.anthropic.com
ANTHROPIC_API_KEY=

# 공공데이터포털 인증키 (필수, R1 요건) — data.go.kr 마이페이지
DATA_GO_KR_API_KEY=

# 벤치마크 비교 대상 (선택)
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# 런타임 설정
DEMO_MODE=live            # live | cached (발표장 오프라인 대비)
DATABASE_PATH=data/krosetta.db
